  "statesProvidedByWrapperNote": "Эти состояния в вёрстке часто висят на обёртке поля, а не на самом инпуте (.is-invalid на .field). Их ищем по всему прототипу, а не только в секции компонента, иначе получаются ложные пропуски.",
  "stateMapByComponent": {
    "Tab": {
      "Active": [
        "[aria-selected=\"true\"]",
        ".is-active",
        "[aria-current]"
      ]
    },
    "Tabs-navigation": {
      "Active": [
        "[aria-selected=\"true\"]",
        ".is-active",
        "[aria-current]"
      ]
    },
    "Checkbox": {
      "Selected": [
        "[aria-checked=\"true\"]",
        ":checked"
      ],
      "Half-selected": [
        "[aria-checked=\"mixed\"]",
        ".is-indeterminate"
      ],
      "Selected disabled": [
        "[aria-checked=\"true\"][aria-disabled=\"true\"]"
      ]
    },
    "Checkbox+Text": {
      "Selected": [
        "[aria-checked=\"true\"]",
        ":checked"
      ],
      "Half-selected": [
        "[aria-checked=\"mixed\"]",
        ".is-indeterminate"
      ]
    },
    "Radio": {
      "Selected": [
        "[aria-checked=\"true\"]",
        ":checked"
      ]
    },
    "Radio+Text": {
      "Selected": [
        "[aria-checked=\"true\"]",
        ":checked"
      ]
    },
    ".tile": {
      "Selected": [
        "[aria-pressed=\"true\"]",
        ".is-active",
        ".is-selected"
      ]
    }
  },
  "stateMapNote": "stateMap — общее соответствие состояний ДС селекторам CSS. stateMapByComponent переопределяет его там, где одно и то же слово значит разное: у Button Active — это нажатие, у Tab — выбранная вкладка.",
  "prototypesRoot": "..",
  "prototypesRootNote": "Путь к папке с прототипами относительно корня бота. Так код не привязан к тому, что он лежит внутри папки заказчика."

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Автозапуск телеграм-бота при входе в систему.

  Секретов здесь нет намеренно: launchd умеет держать переменные прямо в plist,
  но там они лежат открытым текстом в файле, который попадает в бэкапы.
  Бот берёт их из ~/.night-watch.env с правами 600.

  Установка:
    1) подставьте свой путь вместо /ПУТЬ/К/night-watch
    2) заполните ~/.night-watch.env, проверьте: python3 bin/tgbot.py --check
    3) cp launchd/com.nightwatch.tgbot.plist ~/Library/LaunchAgents/
    4) launchctl load ~/Library/LaunchAgents/com.nightwatch.tgbot.plist

  Остановить:  launchctl unload ~/Library/LaunchAgents/com.nightwatch.tgbot.plist
  Логи:        ~/Library/Logs/nightwatch-tgbot.log

  KeepAlive стоит с SuccessfulExit=false: перезапускать только при падении.
  Иначе при неверном токене launchd будет крутить бота по кругу.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nightwatch.tgbot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/ПУТЬ/К/night-watch/bin/tgbot.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/ПУТЬ/К/night-watch</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/ВЫ/Library/Logs/nightwatch-tgbot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ВЫ/Library/Logs/nightwatch-tgbot.log</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Autostart the Telegram bot at login (macOS).

  Secrets are deliberately NOT here: launchd can hold env vars in a plist,
  but that is plaintext in a file that ends up in backups. The bot reads
  ~/.night-watch.env (mode 600) instead.

  Install:
    1) put your own path instead of /PATH/TO/night-watch
    2) fill ~/.night-watch.env and verify it (the bot has a check mode;
       see the Telegram section of docs/QUICKSTART.md)
    3) cp launchd/com.nightwatch.tgbot.plist ~/Library/LaunchAgents/
    4) launchctl load ~/Library/LaunchAgents/com.nightwatch.tgbot.plist

  Stop:  launchctl unload ~/Library/LaunchAgents/com.nightwatch.tgbot.plist
  Logs:  ~/Library/Logs/nightwatch-tgbot.log

  KeepAlive uses SuccessfulExit=false: restart only on crashes. Otherwise a
  bad token would make launchd spin the bot in a loop.

  Heads-up: point ProgramArguments at the REAL python3 binary, not the
  /usr/bin/python3 shim — macOS grants disk access to the actual executable.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.nightwatch.tgbot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/PATH/TO/night-watch/bin/tgbot.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/PATH/TO/night-watch</string>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/nightwatch-tgbot.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/nightwatch-tgbot.log</string>
</dict>
</plist>
